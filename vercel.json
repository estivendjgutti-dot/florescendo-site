{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.florescendoflores.com.br"
        }
      ],
      "destination": "https://florescendoflores.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/catalogo/plantas",
      "destination": "/catalogo/",
      "permanent": true
    },
    {
      "source": "/catalogo/plantas/",
      "destination": "/catalogo/",
      "permanent": true
    },
    {
      "source": "/locacao",
      "destination": "/eventos/",
      "permanent": true
    },
    {
      "source": "/locacao/",
      "destination": "/eventos/",
      "permanent": true
    },
    {
      "source": "/catalogo/flores-para-eventos",
      "destination": "/eventos/",
      "permanent": true
    },
    {
      "source": "/catalogo/flores-para-eventos/",
      "destination": "/eventos/",
      "permanent": true
    }
  ]
}
